{
  // zenoh-bridge-ros2dds : Ground PC (Jazzy / ROS_DOMAIN_ID=6) 側
  //   操縦入力とGround heartbeatはcritical_link専用であり、このbridgeでは
  //   一切転送しない。表示に必要な軽量telemetryだけを受け取る。映像は
  //   従来どおりRTP/UDP専用経路を使う。
  mode: "peer",

  // miniPCへの到達経路は固定IPで指定する。実運用の無線経路では mDNS
  // hostname の解決待ち／誤解決により bridge 接続が遅延することがあるため、
  // miniPC の USB Wi-Fi 側固定アドレスを使う。
  // スマートフォンInternet経路を使う場合も7447をInternetへ直接公開せず、
  // WireGuard等のVPN内アドレスをendpointにする。
  connect: {
    endpoints: ["tcp/192.168.212.210:7447"],
  },

  scouting: {
    multicast: { enabled: false },
  },

  plugins: {
    ros2dds: {
      domain: 6,

      allow: {
        publishers: [
        ],
        subscribers: [
          "/odom", "/tf", "/tf_static",
          "/buoy_detections", "/buoy_detections_3d",
          "/virtual_obstacles", "/buoy_roi", "/diagnostics",
          "/heartbeat/driver/camera/front", "/heartbeat/driver/lidar",
          "/joy/set_feedback", "/foxglove_log", "/mission/waypoint_markers",
          "/gui/battery_percent",
        ],
        service_servers: [], service_clients: [],
        action_servers: [], action_clients: [],
      },
    },
  },
}
