{
  // zenoh-bridge-ros2dds : miniPC (Humble) 側
  //   ROS_DOMAIN_ID=5 のローカル DDS と zenoh を橋渡しする。
  //   Jetson とは DDS discovery を一切共有しないため、distro 混在による
  //   ParticipantEntitiesInfo のデシリアライズ失敗（sequence size exceeds
  //   remaining buffer）が起きない。
  mode: "peer",

  // Jetson 側ブリッジからの接続を受ける。IP は有線 NIC のもの。
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },

  // 有線直結なのでマルチキャストスカウティングは不要。
  scouting: {
    multicast: { enabled: false },
  },

  plugins: {
    ros2dds: {
      domain: 5,

      // JetsonとGround PCの両bridgeに対するunion。各remote bridge側では
      // 役割別にさらに絞り込む。
      // Docs/two_machine_split.md「トピックの流れ」に対応。地上側の
      // /ground_video/image/compressed は意図的に含めず、Jetson へ戻さない。
      // LivoxのrawデータはminiPCのlocal EKFが使う/livox/imuだけを通し、
      // 大容量の/livox/lidarはJetson内に閉じ込める。
      allow: {
        publishers: [
          "/odom", "/tf", "/tf_static", "/livox/imu",
          "/buoy_detections", "/buoy_detections_3d",
          "/virtual_obstacles", "/buoy_roi", "/diagnostics",
          "/planned_path_pruned", "/task2/safety_points",
          "/heartbeat/driver/camera/front", "/heartbeat/driver/lidar",
          "/heartbeat/ground_station",
          "/joy", "/joy/set_feedback",
          "/foxglove_log",
          "/gui/battery_percent",
        ],
        subscribers: [
          "/odom", "/tf", "/tf_static", "/livox/imu",
          "/buoy_detections", "/buoy_detections_3d",
          "/virtual_obstacles", "/buoy_roi", "/diagnostics",
          "/planned_path_pruned", "/task2/safety_points",
          "/heartbeat/driver/camera/front", "/heartbeat/driver/lidar",
          "/heartbeat/ground_station",
          "/joy", "/joy/set_feedback",
          "/foxglove_log",
          "/gui/battery_percent",
        ],
        service_servers: [], service_clients: [],
        action_servers: [], action_clients: [],
      },
    },
  },
}
