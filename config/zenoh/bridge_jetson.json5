{
  // zenoh-bridge-ros2dds : Jetson (Jazzy) 側
  //   ROS_DOMAIN_ID=6 のローカル DDS と zenoh を橋渡しする。
  //   Ground PC用のbridgeとは分離し、Jetsonで生成・消費するtopicだけを
  //   通す。地上側でRTP/JPEGを受けて生成する
  //   /ground_video/image/compressed は含めない。
  //   Livoxのrawデータは/livox/imuだけを通し、/livox/lidarはJetson内に
  //   閉じ込める。
  mode: "peer",

  // <MINIPC_IP> は miniPC の有線 NIC の IP に置き換える。
  connect: {
    endpoints: ["tcp/gembu-EliteMini-Series.local:7447"],
  },

  scouting: {
    multicast: { enabled: false },
  },

  plugins: {
    ros2dds: {
      domain: 6,

      allow: {
        publishers: [
          "/odom", "/tf", "/tf_static", "/livox/imu",
          "/buoy_detections", "/buoy_detections_3d",
          "/virtual_obstacles", "/buoy_roi", "/diagnostics",
          "/planned_path_pruned", "/task2/safety_points",
          "/heartbeat/driver/camera/front", "/heartbeat/driver/lidar",
          "/foxglove_log",
        ],
        subscribers: [
          "/odom", "/tf", "/tf_static", "/livox/imu",
          "/buoy_detections", "/buoy_detections_3d",
          "/virtual_obstacles", "/buoy_roi", "/diagnostics",
          "/planned_path_pruned", "/task2/safety_points",
          "/heartbeat/driver/camera/front", "/heartbeat/driver/lidar",
          "/foxglove_log",
        ],
        service_servers: [], service_clients: [],
        action_servers: [], action_clients: [],
      },
    },
  },
}
